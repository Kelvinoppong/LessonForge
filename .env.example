# ---- Database (Neon Postgres) ----
# Grab this from the Neon dashboard or `vercel env pull` after linking the integration.
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/lessonforge?sslmode=require"

# ---- Content AI service (Python/FastAPI, deployed separately on Vercel) ----
# Local dev default; in production set this to the deployed service URL.
CONTENT_AI_URL="http://127.0.0.1:8000"
# Shared secret so only this app can call the AI service.
CONTENT_AI_TOKEN="dev-local-token-change-me"

# ---- OpenAI (used by the content-ai service) ----
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o"
OPENAI_TTS_MODEL="gpt-4o-mini-tts"

# ---- Vercel Blob (generated lesson audio) ----
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# ---- Cron protection ----
# Vercel sends this as a bearer token on scheduled invocations.
CRON_SECRET="generate-a-long-random-string"
